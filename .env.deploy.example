# Mikcore web storefront deployment (provided by operations)
NEXT_PUBLIC_DATA_MODE=real
# Fixed server-only upstream. Do not prefix /api/shop.
SHOP_BACKEND_ORIGIN=https://shop.test.mikcore.ir
# This is the sole provided storefront hostname. Add other VERIFIED shop domains explicitly.
SHOP_ALLOWED_HOSTS=shop.p.mikcore.ir
# Do not enable until authenticated ingress validates ALL hostnames and domain ownership.
SHOP_TRUSTED_HOST_INGRESS=false
NEXT_PUBLIC_APP_VERSION=0.1.0
