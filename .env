# Set demo for local sample data; restart the server after changing this file.
NEXT_PUBLIC_DATA_MODE=real
SHOP_BACKEND_ORIGIN=http://127.0.0.1:3104
# Wildcards match one shop label only; the base domain remains explicitly listed.
SHOP_ALLOWED_HOSTS=localhost,127.0.0.1,shop.p.mikcore.ir,*.shop.p.mikcore.ir
SHOP_TRUSTED_HOST_INGRESS=false
NEXT_PUBLIC_APP_VERSION=0.1.0
