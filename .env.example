# real uses the supplied mik-shop Host-aware backend; demo stays explicit.
NEXT_PUBLIC_DATA_MODE=real
# Server-only fixed origin. Never expose private backend origin to browsers.
SHOP_BACKEND_ORIGIN=http://127.0.0.1:3002
# Comma-separated trusted storefront hostnames (including verified custom domains).
# Configure DNS / reverse proxy Host validation for dynamic domains before production.
SHOP_ALLOWED_HOSTS=melika.mikshop.ir,shop.example.ir

# Alternative to a static allowlist for verified custom domains ONLY.
# Set true ONLY if an authenticated ingress validates Host against active domain ownership
# and rejects unregistered domains/Host overrides before reaching Next.js.
SHOP_TRUSTED_HOST_INGRESS=false

# Version visible in backend Audit headers. Keep aligned with package.json.
NEXT_PUBLIC_APP_VERSION=0.1.0

# /demo is available even with DATA_MODE=real. Never redirects real API failures to Demo.
